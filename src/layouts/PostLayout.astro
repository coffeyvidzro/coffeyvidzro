---
import "../styles/global.css";
import type { PostLayoutProps } from "../types";
import FormattedDate from "../components/widgets/FormattedDate.astro";
import BaseHead from "../components/layout/Head.astro";
import Footer from "../components/layout/Footer.astro";
import BackButton from "../components/ui/BackButton.astro";
import TableOfContents from "../components/ui/TableOfContents.astro";
import GradientMask from "../components/ui/GradientMask.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { personSchema } from "../lib/seo/person";
import { websiteSchema } from "../lib/seo/website";
import { webpageSchema } from "../lib/seo/webpage";
import { articleId, articleSchema } from "../lib/seo/article";

const {
  title,
  description,
  pubDate,
  updatedDate,
  image,
  readingTime,
  toc = [],
} = Astro.props as PostLayoutProps;

const path = Astro.url.pathname;
const jsonLd = [
  personSchema(),
  websiteSchema(),
  webpageSchema({
    path,
    name: title,
    description,
    mainEntityId: articleId(path),
  }),
  articleSchema({ path, title, description, pubDate, updatedDate, image }),
];
---

<BaseLayout title={title} description={description} type="post">
  <BaseHead
    title={title}
    description={description}
    image={image}
    type="article"
    publishedTime={pubDate}
    modifiedTime={updatedDate}
    jsonLd={jsonLd}
    slot="head"
  />
  <div class="post-container">
    <main>
      <div class="prose">
        <GradientMask />
        <BackButton />
        {toc.length > 0 && <TableOfContents toc={toc} />}
        <div class="title">
          <h1>{title}</h1>
          <div class="date">
            <FormattedDate date={pubDate} />
            {
              readingTime && (
                <span class="reading-time">
                  <span class="separator">·</span>
                  {readingTime}
                </span>
              )
            }
          </div>
        </div>
        <article class="content">
          <slot />
        </article>
      </div>
    </main>
    <Footer />
  </div>
</BaseLayout>

<style>
  .post-container {
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .post-container main {
    flex: 1;
  }
</style>
