---
import "../styles/global.css";
import BaseHead from "../components/layout/Head.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import BaseLayout from "./BaseLayout.astro";
import GradientMask from "../components/ui/GradientMask.astro";
import { SITE_SCHEMA } from "../consts";

const { title, description } = Astro.props;
---

<BaseLayout title={title} description={description} type="page">
  <BaseHead title={title} description={description} jsonLd={SITE_SCHEMA} slot="head" />
  <a class="skip-link" href="#main-content">Skip to content</a>

  <div class="page-content">
    <GradientMask />
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
  </div>
</BaseLayout>

<style is:global>
  .page-content {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .page-content main {
    flex: 1;
  }

  .skip-link {
    position: absolute;
    left: 1.5rem;
    top: -5rem;
    z-index: 110;
    background: var(--bg);
    color: var(--text-primary);
    border: 1px solid var(--border);
    padding: 0.5rem 0.75rem;
  }

  .skip-link:focus {
    top: 0.75rem;
  }
</style>
