---
import { getCollection } from "astro:content";
import Container from "../../components/Container.astro";
import Layout from "../../layouts/Layout.astro";
import { PROJECTS } from "../../consts";
import FormattedDate from "../../components/FormattedDate.astro";

const projects = (
  await getCollection("projects", ({ data }) => !data.draft)
).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Layout title={PROJECTS.title} description={PROJECTS.description}>
  <Container>
    <main class="py-16 sm:py-24">
      <header class="max-w-2xl">
        <p class="mb-4 text-sm font-medium uppercase tracking-[0.2em] opacity-60">
          Adventures
        </p>
        <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">{PROJECTS.title}</h1>
        <p class="mt-6 text-lg leading-8 opacity-70">{PROJECTS.description}</p>
      </header>

      <div class="mt-16 space-y-10">
        {
          projects.map((project, index) => (
            <article class="group border-t pt-8">
              <div class="flex flex-col gap-6 sm:flex-row sm:items-start sm:justify-between">
                <div class="max-w-2xl">
                  <p class="text-sm opacity-50">{String(index + 1).padStart(2, "0")}</p>
                  <h2 class="mt-2 text-2xl font-semibold tracking-tight">
                    <a
                      href={`/projects/${project.id}`}
                      class="transition-opacity hover:opacity-60"
                    >
                      {project.data.title}
                    </a>
                  </h2>
                  <p class="mt-3 leading-7 opacity-70">{project.data.description}</p>
                </div>

                <p class="shrink-0 text-sm opacity-50 sm:pt-1">
                  <FormattedDate date={project.data.pubDate} />
                </p>
              </div>

              <div class="mt-6">
                <a
                  href={`/projects/${project.id}`}
                  class="text-sm font-medium underline underline-offset-4 transition-opacity hover:opacity-60"
                >
                  Read the adventure →
                </a>
              </div>
            </article>
          ))
        }
      </div>
    </main>
  </Container>
</Layout>
