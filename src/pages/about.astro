---
import Container from "../components/Container.astro";
import Layout from "../layouts/Layout.astro";
import { ABOUT, SITE } from "../consts";
---

<Layout title={ABOUT.title} description={ABOUT.description} type="profile">
  <Container>
    <section class="py-24 md:py-32">
      <p class="mb-4 text-sm uppercase tracking-[0.2em] opacity-60">About</p>
      <h1 class="max-w-4xl text-5xl font-semibold tracking-tight md:text-7xl">
        I’m Coffey Vidzro.
      </h1>
      <p class="mt-6 max-w-2xl text-xl leading-8 opacity-70 md:text-2xl">
        A product engineer who likes turning ideas into working software—and learning what happens along the way.
      </p>
    </section>

    <div class="grid gap-16 border-t py-16 md:grid-cols-[1fr_2fr]">
      <div>
        <p class="text-sm uppercase tracking-[0.2em] opacity-60">A little context</p>
      </div>
      <div class="max-w-2xl space-y-6 leading-8 opacity-80">
        <p>
          I build software across the stack, from product experiences people use directly to the infrastructure that sits underneath them.
        </p>
        <p>
          Some of my adventures are deliberately small. Others turn into deeper explorations of APIs, distributed systems, commerce, communication infrastructure, and the messy space between an idea and a working product.
        </p>
        <p>
          I don't want every experiment to become a company. Sometimes the point is simply to build something far enough to understand the problem better.
        </p>
      </div>
    </div>

    <div class="grid gap-16 border-t py-16 md:grid-cols-[1fr_2fr]">
      <div>
        <p class="text-sm uppercase tracking-[0.2em] opacity-60">What I’m building</p>
      </div>
      <div class="max-w-2xl space-y-8">
        <div>
          <h2 class="text-2xl font-semibold tracking-tight">10Blob</h2>
          <p class="mt-2 leading-7 opacity-70">
            A social-commerce experiment for sellers who already sell through channels like WhatsApp, Instagram, and TikTok.
          </p>
          <a href="/projects/10blob/" class="mt-3 inline-block underline underline-offset-4">Explore 10Blob →</a>
        </div>
        <div>
          <h2 class="text-2xl font-semibold tracking-tight">Dugble</h2>
          <p class="mt-2 leading-7 opacity-70">
            A communications infrastructure adventure exploring transactional email, A2P SMS, OTPs, providers, queues, and reliability.
          </p>
          <a href="/projects/dugble/" class="mt-3 inline-block underline underline-offset-4">Explore Dugble →</a>
        </div>
      </div>
    </div>

    <div class="grid gap-16 border-t py-16 md:grid-cols-[1fr_2fr]">
      <div>
        <p class="text-sm uppercase tracking-[0.2em] opacity-60">How I work</p>
      </div>
      <div class="max-w-2xl space-y-6 leading-8 opacity-80">
        <p>
          I like simple interfaces, useful abstractions, and understanding systems rather than hiding from their complexity.
        </p>
        <p>
          Most of what I know comes from building, breaking, debugging, and trying again. This site is where I document some of that process.
        </p>
      </div>
    </div>

    <section class="border-t py-16">
      <p class="max-w-2xl text-lg leading-8 opacity-70">
        Want to talk about software, products, or something you're building?
        <a href={`mailto:${SITE.email}`} class="underline underline-offset-4">Send me an email →</a>
      </p>
    </section>
  </Container>
</Layout>
