---
import { getCollection } from "astro:content";
import Container from "../components/Container.astro";
import FormattedDate from "../components/FormattedDate.astro";
import Layout from "../layouts/Layout.astro";
import { HOME, SITE_SCHEMA } from "../consts";

const posts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 2);

const projects = (await getCollection("projects", ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<Layout title={HOME.title} description={HOME.description} jsonLd={SITE_SCHEMA}>
  <Container>
    <section class="py-24 md:py-32">
      <p class="mb-4 text-sm tracking-[0.2em] uppercase opacity-60">
        Coffey Vidzro
      </p>
      <h1 class="max-w-4xl text-5xl font-semibold tracking-tight md:text-7xl">
        I build things.
      </h1>
      <p class="mt-6 max-w-2xl text-xl leading-8 opacity-70 md:text-2xl">
        Product engineer exploring software, products, infrastructure, and the
        occasional strange idea.
      </p>
      <div class="mt-8 flex flex-wrap gap-4">
        <a href="/projects/" class="underline underline-offset-4"
          >Explore my adventures</a
        >
        <a href="/blog/" class="underline underline-offset-4">Read my writing</a
        >
        <a href="/about/" class="underline underline-offset-4">About me</a>
      </div>
    </section>

    <section class="border-t py-16">
      <div class="flex items-end justify-between gap-6">
        <div>
          <p class="text-sm tracking-[0.2em] uppercase opacity-60">
            Adventures
          </p>
          <h2 class="mt-2 text-3xl font-semibold tracking-tight">
            Things I’ve built and explored.
          </h2>
        </div>
        <a
          href="/projects/"
          class="hidden underline underline-offset-4 md:block">View all</a
        >
      </div>

      <div class="mt-10 grid gap-8 md:grid-cols-3">
        {
          projects.map((project) => (
            <article>
              <p class="text-sm opacity-50">
                <FormattedDate date={project.data.pubDate} />
              </p>
              <h3 class="mt-2 text-xl font-semibold">
                <a
                  href={`/projects/${project.id}/`}
                  class="underline underline-offset-4"
                >
                  {project.data.title}
                </a>
              </h3>
              <p class="mt-3 leading-7 opacity-70">
                {project.data.description}
              </p>
            </article>
          ))
        }
      </div>
    </section>

    <section class="border-t py-16">
      <div class="flex items-end justify-between gap-6">
        <div>
          <p class="text-sm tracking-[0.2em] uppercase opacity-60">Writing</p>
          <h2 class="mt-2 text-3xl font-semibold tracking-tight">
            Things I’m learning while building.
          </h2>
        </div>
        <a href="/blog/" class="hidden underline underline-offset-4 md:block"
          >Read all</a
        >
      </div>

      <div class="mt-10 space-y-8">
        {
          posts.map((post) => (
            <article class="border-b pb-8 last:border-b-0">
              <p class="text-sm opacity-50">
                <FormattedDate date={post.data.pubDate} />
              </p>
              <h3 class="mt-2 text-2xl font-semibold tracking-tight">
                <a
                  href={`/blog/${post.id}/`}
                  class="underline underline-offset-4"
                >
                  {post.data.title}
                </a>
              </h3>
              <p class="mt-3 max-w-2xl leading-7 opacity-70">
                {post.data.description}
              </p>
            </article>
          ))
        }
      </div>
    </section>
  </Container>
</Layout>
