---
import FormattedDate from "../../components/FormattedDate.astro";
import Container from "../../components/Container.astro";
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import { BLOG } from "../../consts";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<Layout title={BLOG.title} description={BLOG.description}>
  <Container>
    <main class="py-16 sm:py-24">
      <header class="max-w-2xl">
        <p class="mb-4 text-sm font-medium uppercase tracking-[0.2em] opacity-60">
          Writing
        </p>
        <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">{BLOG.title}</h1>
        <p class="mt-6 text-lg leading-8 opacity-70">{BLOG.description}</p>
      </header>

      <section class="mt-16" aria-labelledby="recent-writing">
        <h2 id="recent-writing" class="sr-only">Recent writing</h2>
        <div class="divide-y border-t">
          {
            posts.map((post) => (
              <article class="py-8 first:pt-8">
                <div class="flex flex-col gap-3 sm:flex-row sm:items-baseline sm:justify-between sm:gap-8">
                  <h3 class="text-xl font-semibold tracking-tight">
                    <a
                      href={`/blog/${post.id}/`}
                      class="transition-opacity hover:opacity-60"
                    >
                      {post.data.title}
                    </a>
                  </h3>
                  <p class="shrink-0 text-sm opacity-50">
                    <FormattedDate date={post.data.pubDate} />
                  </p>
                </div>
                <p class="mt-3 max-w-2xl leading-7 opacity-70">{post.data.description}</p>
                <a
                  href={`/blog/${post.id}/`}
                  class="mt-5 inline-block text-sm font-medium underline underline-offset-4 transition-opacity hover:opacity-60"
                >
                  Read →
                </a>
              </article>
            ))
          }
        </div>
      </section>
    </main>
  </Container>
</Layout>
