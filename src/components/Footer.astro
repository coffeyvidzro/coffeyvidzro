---
import Container from "./Container.astro";
import { SITE } from "../consts";
---

<footer class="border-t">
  <Container>
    <div
      class="flex flex-col gap-6 py-10 sm:flex-row sm:items-center sm:justify-between"
    >
      <div>
        <a
          href="/"
          class="font-semibold tracking-tight transition-opacity hover:opacity-60"
        >
          {SITE.name}
        </a>
        <p class="mt-2 text-sm opacity-60">
          Building things to understand things.
        </p>
      </div>

      <nav
        class="flex flex-wrap gap-x-5 gap-y-2 text-sm opacity-70"
        aria-label="Footer navigation"
      >
        <a href="/projects" class="transition-opacity hover:opacity-100"
          >Adventures</a
        >
        <a href="/blog" class="transition-opacity hover:opacity-100">Writing</a>
        <a href="/about" class="transition-opacity hover:opacity-100">About</a>
        <a
          href="mailto:hello@vidzro.com"
          class="transition-opacity hover:opacity-100">Email</a
        >
      </nav>
    </div>

    <div class="border-t py-6 text-sm opacity-50">
      © {new Date().getFullYear()}
      {SITE.name}. Built with curiosity.
    </div>
  </Container>
</footer>
