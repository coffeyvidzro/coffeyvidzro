---
const projects = [
  {
    name: "Leamout",
    description: "I’m building a SIP-native runtime and control plane for autonomous voice agents.",
    href: "https://leamout.com",
    external: true,
  },
  {
    name: "10Blob",
    description: "I built a focused commerce experience around how people already sell on social media.",
    href: "/why-i-built-10blob",
    external: false,
  },
  {
    name: "Shiyao",
    description: "I use lightweight Firecracker microVMs to isolate untrusted AI-agent workloads.",
    href: "/why-ai-agents-need-a-sandbox",
    external: false,
  },
];
---

<section class="projects" id="projects" aria-labelledby="projects-heading">
  <h2 id="projects-heading">Things I’ve built</h2>

  <ul>
    {
      projects.map((project) => (
        <li>
          <a
            href={project.href}
            target={project.external ? "_blank" : undefined}
            rel={project.external ? "noopener noreferrer" : undefined}
          >
            <span class="project-details">
              <strong>{project.name}</strong>
              <span class="description">{project.description}</span>
            </span>
            <span class="arrow" aria-hidden="true">
              {project.external ? "↗" : "→"}
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .projects {
    margin-bottom: 4.5rem;
    scroll-margin-top: 2rem;
  }

  h2 {
    font-size: var(--font-size-m);
    font-weight: var(--font-weight-bold);
    margin: 0 0 1.5rem;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  li {
    border-bottom: 1px solid var(--border);
  }

  li:first-child {
    border-top: 1px solid var(--border);
  }

  li a {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.5rem;
    color: var(--text-primary);
    padding: 1.1rem 0;
    text-decoration: none;
  }

  .project-details {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  strong {
    font-weight: var(--font-weight-bold);
  }

  .description {
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .arrow {
    color: var(--text-tertiary);
    flex-shrink: 0;
    transition: color 0.2s ease-out, transform 0.2s ease-out;
  }

  li a:hover .arrow {
    color: var(--text-primary);
    transform: translateX(2px);
  }

  li a:focus-visible {
    outline-offset: 4px;
  }
</style>
