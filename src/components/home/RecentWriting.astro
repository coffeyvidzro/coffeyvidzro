---
import { getCollection } from "astro:content";

const posts = (await getCollection("contents"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 3);

const formatDate = new Intl.DateTimeFormat("en", {
  month: "short",
  day: "numeric",
  year: "numeric",
});
---

<section class="writing" id="writing" aria-labelledby="writing-heading">
  <h2 id="writing-heading">Recent writing</h2>

  {
    posts.length > 0 ? (
      <ul>
        {posts.map((post) => (
          <li>
            <a href={"/" + post.id}>{post.data.title}</a>
            <time datetime={post.data.pubDate.toISOString()}>
              {formatDate.format(post.data.pubDate)}
            </time>
          </li>
        ))}
      </ul>
    ) : (
      <p>Writing is on its way.</p>
    )
  }
</section>

<style>
  .writing {
    margin-bottom: 1rem;
    scroll-margin-top: 2rem;
  }

  h2 {
    font-size: var(--font-size-m);
    font-weight: var(--font-weight-bold);
    margin: 0 0 1.5rem;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  li {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.55rem 0;
  }

  a {
    color: var(--text-primary);
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 0.2em;
    transition: text-decoration-color 0.2s ease-out;
  }

  a:hover {
    text-decoration-color: var(--text-tertiary);
  }

  time {
    color: var(--text-secondary);
    flex-shrink: 0;
    font-size: var(--font-size-s);
    font-variant-numeric: tabular-nums;
  }

  p {
    color: var(--text-secondary);
  }

  @media (max-width: 420px) {
    li {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.1rem;
      padding: 0.7rem 0;
    }
  }
</style>
